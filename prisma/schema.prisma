generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Member {
  id                String   @id @default(uuid()) @db.Uuid
  full_name         String
  email             String   @unique
  current_handicap  Float    @default(0)
  starting_handicap Float? // Set on first score submission — used for improvement bonus
  is_active         Boolean  @default(true)
  created_at        DateTime @default(now())

  scores           Score[]
  handicap_history HandicapHistory[]
  season_bonuses   SeasonBonus[]
  club_yardages    ClubYardage[]

  @@map("members")
}

model Score {
  id                    String   @id @default(uuid()) @db.Uuid
  member_id             String?  @db.Uuid
  player_name           String
  holes                 Int
  gross_score           Int
  handicap_used         Float
  course_name           String
  course_difficulty     String   @default("average")
  difficulty_multiplier Float    @default(1.0)
  // Handicap inputs — nullable for backward compatibility with pre-handicap rounds.
  course_id             String?  @db.Uuid
  course_rating         Float?
  slope_rating          Int?
  course_par            Int?
  score_differential    Float? // WHS 18-hole-equivalent differential, computed at save
  group_member_ids      String[] @default([])
  group_member_names    String   @default("")
  group_size            Int      @default(1)
  base_points           Float?
  group_bonus           Float    @default(0)
  additional_points     Float    @default(0)
  total_points          Float?
  play_date             DateTime
  notes                 String?
  created_at            DateTime @default(now())

  member           Member?           @relation(fields: [member_id], references: [id], onDelete: SetNull)
  handicap_history HandicapHistory[]
  course           Course?           @relation(fields: [course_id], references: [id], onDelete: SetNull)

  @@map("scores")
}

model Course {
  id            String   @id @default(uuid()) @db.Uuid
  name          String
  tee_name      String   @default("") // e.g. "Blue", "White", "Mens"
  course_rating Float
  slope_rating  Int
  par           Int
  holes         Int      @default(18) // 9 or 18
  hole_pars     Int[]    @default([]) // per-hole pars, learned from live rounds
  is_active     Boolean  @default(true)
  created_at    DateTime @default(now())

  scores Score[]

  @@unique([name, tee_name])
  @@map("courses")
}

model SeasonBonus {
  id           String   @id @default(uuid()) @db.Uuid
  member_id    String   @db.Uuid
  points       Float
  reason       String
  awarded_date DateTime @db.Date
  created_at   DateTime @default(now())

  member Member @relation(fields: [member_id], references: [id], onDelete: Cascade)

  @@map("season_bonuses")
}

model HandicapHistory {
  id          String   @id @default(uuid()) @db.Uuid
  member_id   String   @db.Uuid
  handicap    Float
  score_id    String?  @db.Uuid
  recorded_at DateTime @default(now())

  member Member @relation(fields: [member_id], references: [id], onDelete: Cascade)
  score  Score? @relation(fields: [score_id], references: [id], onDelete: SetNull)

  @@map("handicap_history")
}

model ClubYardage {
  id         String   @id @default(uuid()) @db.Uuid
  member_id  String   @db.Uuid
  club_name  String
  yards      Int
  created_at DateTime @default(now())

  member Member @relation(fields: [member_id], references: [id], onDelete: Cascade)

  @@unique([member_id, club_name])
  @@map("club_yardages")
}

// ── Dan's Birthday Event ───────────────────────────────────────────────────────

model BdayGroup {
  id           String    @id @default(uuid()) @db.Uuid
  name         String
  code         String    @unique
  location_lat Float?
  location_lon Float?
  location_at  DateTime?
  created_at   DateTime  @default(now())

  teams BdayTeam[]

  @@map("bday_groups")
}

model BdayTeam {
  id         String   @id @default(uuid()) @db.Uuid
  group_id   String   @db.Uuid
  name       String
  player1    String   @default("")
  player2    String   @default("")
  created_at DateTime @default(now())

  group              BdayGroup       @relation(fields: [group_id], references: [id], onDelete: Cascade)
  hole_scores        BdayHoleScore[]
  activities         BdayActivity[]
  mulligans_sent     BdayMulligan[]  @relation("MulliganSender")
  mulligans_received BdayMulligan[]  @relation("MulliganTarget")

  @@map("bday_teams")
}

model BdayHoleScore {
  id      String @id @default(uuid()) @db.Uuid
  team_id String @db.Uuid
  hole    Int
  strokes Int

  team BdayTeam @relation(fields: [team_id], references: [id], onDelete: Cascade)

  @@unique([team_id, hole])
  @@map("bday_hole_scores")
}

model BdayActivity {
  id        String   @id @default(uuid()) @db.Uuid
  team_id   String   @db.Uuid
  type      String // "beer" | "hotdog"
  hole      Int?
  player    String?
  logged_at DateTime @default(now())

  team BdayTeam @relation(fields: [team_id], references: [id], onDelete: Cascade)

  @@map("bday_activities")
}

model BdayMulligan {
  id        String   @id @default(uuid()) @db.Uuid
  sender_id String   @db.Uuid
  target_id String   @db.Uuid
  hole      Int?
  fired_at  DateTime @default(now())

  sender BdayTeam @relation("MulliganSender", fields: [sender_id], references: [id], onDelete: Cascade)
  target BdayTeam @relation("MulliganTarget", fields: [target_id], references: [id], onDelete: Cascade)

  @@map("bday_mulligans")
}

model BdayMessage {
  id          String   @id @default(uuid()) @db.Uuid
  sender_name String
  text        String
  sent_at     DateTime @default(now())

  @@map("bday_messages")
}

// ── Live round tracking (Phase 2) ──────────────────────────────────────────────

model LiveRound {
  id               String    @id @default(uuid()) @db.Uuid
  member_id        String    @db.Uuid
  player_name      String
  course_id        String?   @db.Uuid
  course_name      String
  holes            Int
  play_date        DateTime
  group_member_ids String[]  @default([])
  current_hole     Int       @default(1)
  started_at       DateTime  @default(now())
  completed_at     DateTime?
  score_id         String?   @db.Uuid // the Score created when the round is finished

  hole_scores LiveHoleScore[]

  @@map("live_rounds")
}

model LiveHoleScore {
  id            String @id @default(uuid()) @db.Uuid
  live_round_id String @db.Uuid
  hole          Int
  strokes       Int
  putts         Int? // null = not recorded
  par           Int    @default(4)

  round LiveRound @relation(fields: [live_round_id], references: [id], onDelete: Cascade)

  @@unique([live_round_id, hole])
  @@map("live_hole_scores")
}

// SSL Open: snapshot the field/course so live scoring stays stable during play.
model SslOpenEvent {
  id            String    @id
  course_id     String    @db.Uuid
  course_name   String
  tee_name      String
  play_date     DateTime  @db.Date
  course_rating Float
  slope_rating  Int
  course_par    Int
  hole_pars     Int[]
  difficulty    String
  finalized_at  DateTime?
  updated_at    DateTime  @default(now()) @updatedAt

  groups  SslOpenGroup[]
  players SslOpenPlayer[]

  @@map("ssl_open_events")
}

model SslOpenGroup {
  id           String @id @default(uuid()) @db.Uuid
  event_id     String
  name         String
  tee_time     String
  sort_order   Int
  scoring_code String @unique

  event   SslOpenEvent    @relation(fields: [event_id], references: [id], onDelete: Cascade)
  players SslOpenPlayer[]

  @@unique([event_id, sort_order])
  @@map("ssl_open_groups")
}

model SslOpenPlayer {
  id              String    @id @default(uuid()) @db.Uuid
  event_id        String
  group_id        String    @db.Uuid
  member_id       String    @db.Uuid
  player_name     String
  handicap        Float
  sort_order      Int
  mode            String?
  double_down     Boolean   @default(false)
  scores          Int[]
  version         Int       @default(0)
  // Keep these locks even when a previously entered hole is cleared.
  started_at      DateTime?
  back_started_at DateTime?
  score_id        String?   @unique @db.Uuid
  bonus_id        String?   @unique @db.Uuid

  event SslOpenEvent @relation(fields: [event_id], references: [id], onDelete: Cascade)
  group SslOpenGroup @relation(fields: [group_id], references: [id], onDelete: Cascade)

  @@unique([event_id, member_id])
  @@unique([group_id, sort_order])
  @@map("ssl_open_players")
}

// ===========================================================================
// PolyDan — family prediction market for Iron Man, served at /polydan.
// Every model is prefixed Pd and mapped to a polydan_* table so it can't
// collide with league data. Code lives in lib/polydan, app/polydan.
// ===========================================================================

// ---------------------------------------------------------------------------
// People who bet. Money lives in the ledger; a user's balance is the sum of
// their PdLedgerEntry rows. Money is stored in integer cents ($1 = 100).
// ---------------------------------------------------------------------------

model PdUser {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  pinHash   String
  isAdmin   Boolean  @default(false)
  createdAt DateTime @default(now())

  ledger    PdLedgerEntry[]
  positions PdPosition[]
  trades    PdTrade[]

  @@map("polydan_users")
}

enum PdLedgerKind {
  DEPOSIT // admin credited money after being paid
  WITHDRAWAL // admin cashed someone out
  BUY
  SELL
  PAYOUT // market settled
  REFUND // market voided

  @@map("polydan_ledger_kind")
}

model PdLedgerEntry {
  id          Int          @id @default(autoincrement())
  userId      Int
  user        PdUser       @relation(fields: [userId], references: [id])
  kind        PdLedgerKind
  amountCents Int // signed: + money in, - money out
  note        String?
  marketId    Int?
  market      PdMarket?    @relation(fields: [marketId], references: [id])
  createdAt   DateTime     @default(now())

  @@index([userId])
  @@map("polydan_ledger")
}

// ---------------------------------------------------------------------------
// The Iron Man event: competitors, editions, and the round-by-round results
// the admin enters. Standings are derived from PdResultEvent, never stored.
// ---------------------------------------------------------------------------

model PdCompetitor {
  id       Int              @id @default(autoincrement())
  name     String           @unique
  entries  PdEditionEntry[]
  outcomes PdOutcome[]
  results  PdResultEvent[]
  copper   PdCopperScore[]
  idols    PdIdol[]

  @@map("polydan_competitors")
}

enum PdEditionStatus {
  SETUP
  LIVE
  FINISHED

  @@map("polydan_edition_status")
}

model PdEdition {
  id          Int             @id @default(autoincrement())
  number      Int             @unique
  date        DateTime?
  status      PdEditionStatus @default(SETUP)
  createdAt   DateTime        @default(now())
  // Admin clicked "Finalize Copper Cup": the points table is final.
  copperFinal Boolean         @default(false)
  // Copper Cup points by finishing place in an event: 1st, 2nd, 3rd, …
  copperScale String          @default("10,8,6,5,4,3,2,1")

  entries PdEditionEntry[]
  results PdResultEvent[]
  markets PdMarket[]
  events  PdEvent[]
  idols   PdIdol[]

  @@map("polydan_editions")
}

model PdEditionEntry {
  editionId    Int
  edition      PdEdition    @relation(fields: [editionId], references: [id], onDelete: Cascade)
  competitorId Int
  competitor   PdCompetitor @relation(fields: [competitorId], references: [id])

  @@id([editionId, competitorId])
  @@map("polydan_edition_entries")
}

enum PdResultKind {
  TO_ISLAND // lost a round, sent to Redemption Island
  OUT // eliminated for good (from the main game or from the island)
  RETURN // survived Redemption Island, back in the game

  @@map("polydan_result_kind")
}

model PdResultEvent {
  id           Int          @id @default(autoincrement())
  editionId    Int
  edition      PdEdition    @relation(fields: [editionId], references: [id], onDelete: Cascade)
  round        Int
  competitorId Int
  competitor   PdCompetitor @relation(fields: [competitorId], references: [id])
  kind         PdResultKind
  createdAt    DateTime     @default(now())

  @@index([editionId])
  @@map("polydan_results")
}

// ---------------------------------------------------------------------------
// Markets. Prices come from an LMSR market maker over each market's live
// outcomes (lib/lmsr.ts). WINNER / TOP_N / H2H markets resolve themselves
// from the edition's results (lib/resolve.ts); CUSTOM markets are resolved
// by the admin.
// ---------------------------------------------------------------------------

enum PdMarketKind {
  WINNER
  TOP_N
  H2H
  CUSTOM
  COPPER // who wins the Copper Cup (most points across Copper Cup events)

  @@map("polydan_market_kind")
}

enum PdMarketStatus {
  OPEN
  CLOSED // admin paused trading
  SETTLED
  VOID

  @@map("polydan_market_status")
}

model PdMarket {
  id           Int            @id @default(autoincrement())
  editionId    Int
  edition      PdEdition      @relation(fields: [editionId], references: [id])
  kind         PdMarketKind
  question     String
  topN         Int?
  b            Float // LMSR liquidity: higher = prices move less per dollar
  status       PdMarketStatus @default(OPEN)
  // CUSTOM markets: admin-chosen payout per outcome id, e.g. {"12": 1}
  manualResult Json?
  createdAt    DateTime       @default(now())
  settledAt    DateTime?

  outcomes PdOutcome[]
  trades   PdTrade[]
  ledger   PdLedgerEntry[]

  @@index([editionId])
  @@map("polydan_markets")
}

model PdOutcome {
  id           Int           @id @default(autoincrement())
  marketId     Int
  market       PdMarket      @relation(fields: [marketId], references: [id], onDelete: Cascade)
  label        String
  sort         Int           @default(0)
  // WINNER: the competitor. TOP_N: the competitor on the YES side. H2H: each side.
  competitorId Int?
  competitor   PdCompetitor? @relation(fields: [competitorId], references: [id])
  // TOP_N only: true for the YES outcome
  isYes        Boolean?
  // LMSR quantity (shares sold, plus the seed that sets the opening price)
  q            Float         @default(0)

  positions PdPosition[]
  trades    PdTrade[]

  @@map("polydan_outcomes")
}

model PdPosition {
  userId    Int
  user      PdUser    @relation(fields: [userId], references: [id])
  outcomeId Int
  outcome   PdOutcome @relation(fields: [outcomeId], references: [id], onDelete: Cascade)
  shares    Float     @default(0)

  @@id([userId, outcomeId])
  @@map("polydan_positions")
}

model PdTrade {
  id          Int       @id @default(autoincrement())
  userId      Int
  user        PdUser    @relation(fields: [userId], references: [id])
  marketId    Int
  market      PdMarket  @relation(fields: [marketId], references: [id], onDelete: Cascade)
  outcomeId   Int
  outcome     PdOutcome @relation(fields: [outcomeId], references: [id], onDelete: Cascade)
  shares      Float // + bought, - sold
  costCents   Int // + paid by the user, - received
  // {outcomeId: price} right after the trade, for the price chart
  pricesAfter Json
  createdAt   DateTime  @default(now())

  @@index([marketId, createdAt])
  @@map("polydan_trades")
}

// Steven's event schedule. Round N is played on the event with seq N.
// Unrevealed events are visible only to admins.
model PdEvent {
  id          Int       @id @default(autoincrement())
  editionId   Int
  edition     PdEdition @relation(fields: [editionId], references: [id], onDelete: Cascade)
  seq         Int
  name        String
  description String?
  islandOpen  Boolean   @default(true) // losers can go to Redemption Island
  copperCup   Boolean   @default(false) // counts toward the Copper Cup
  revealed    Boolean   @default(false)

  copper PdCopperScore[]

  @@unique([editionId, seq])
  @@map("polydan_events")
}

// Copper Cup result for one competitor in one event: finishing place and the
// points that place earned on the edition's scale.
model PdCopperScore {
  eventId      Int
  event        PdEvent      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  competitorId Int
  competitor   PdCompetitor @relation(fields: [competitorId], references: [id])
  place        Int?
  points       Float

  @@id([eventId, competitorId])
  @@map("polydan_copper_scores")
}

enum PdIdolKind {
  FOUND
  PLAYED

  @@map("polydan_idol_kind")
}

// Immunity idol log: who found it, and the round it was played.
model PdIdol {
  id           Int          @id @default(autoincrement())
  editionId    Int
  edition      PdEdition    @relation(fields: [editionId], references: [id], onDelete: Cascade)
  competitorId Int
  competitor   PdCompetitor @relation(fields: [competitorId], references: [id])
  kind         PdIdolKind
  round        Int?
  createdAt    DateTime     @default(now())

  @@index([editionId])
  @@map("polydan_idols")
}
